# Git
.git/
.gitignore

# Documentation (not needed in production)
README.md
docs/

# Docker files (only dev-specific files excluded; prod configs are needed)
docker/nginx/
docker-compose*.yml
.dockerignore
Dockerfile
docker/php/Dockerfile

# Development dependencies
node_modules/
npm-debug.log*

# Tests (not needed in production)
tests/
.phpunit.xml
.phpunit.result.cache

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Kilo CLI configuration (development tool)
.kilo/

# Environment files (will be mounted or set via env vars)
.env*
!.env.example

# Laravel storage (will be created at runtime)
storage/app/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*

# Bootstrap cache (will be created at runtime)
bootstrap/cache/*