# Production environment secrets
# Copy this file to .env.prod on your production server and fill in the values.
# .env.prod is listed in .gitignore and must NEVER be committed.

APP_NAME="Mould Tracking System"
APP_KEY=                        # Generate with: php artisan key:generate --show
APP_URL=https://yourdomain.com

LOG_LEVEL=error

# Database credentials
DB_DATABASE=mould_tracking
DB_USERNAME=mould_user
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_root_password

# Redis (leave REDIS_PASSWORD blank if no auth)
REDIS_PASSWORD=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
